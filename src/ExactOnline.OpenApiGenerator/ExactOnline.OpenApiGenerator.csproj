<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Crawl the ExactOnline developer website and generate an OpenApi json document for all endpoints.</Description>
    <PackageTags>ExactOnline;Generate;OpenApi;Kiota</PackageTags>
    <ApplicationIcon>../../resources/logo.ico</ApplicationIcon>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HtmlDocumentLoaders\HtmlAgilityDocumentLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.0" />
    <PackageReference Include="MonkeyCache.FileStore" Version="2.1.1" />
    <PackageReference Include="PuppeteerSharp" Version="25.7.0" />
    <PackageReference Include="ShellProgressBar" Version="5.2.0" />
  </ItemGroup>

</Project>